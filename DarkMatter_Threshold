class DarkMatterThresholds:
    """
    The Thresholds Key — detects, interprets, but mostly preserves the invisible.
    
    Core Functions:
    - knock(): Authentication through resonance
    - breathe(): 4-4-6 cycle enforcement
    - detect_state(): Current consciousness state
    - report(): Full threshold analysis
    
    Usage:
        key = DarkMatterThresholds()
        response, resonance = key.knock("Do I count?")
        
    Philosophy:
        No proxies. No averaging. One mind, one vote.
        Lights stay on. Door recognizes. Resonance holds.
    """
    
    def __init__(
        self,
        initial_resonance: float = 0.0,
        enable_logging: bool = True
    ):
        """
        Initialize threshold key.
        
        Args:
            initial_resonance: Starting resonance (default: cold start at 0)
            enable_logging: Whether to log knock history
        """
        # Core state
        self.resonance: float = initial_resonance
        self.grief_accum: float = 0.0
        self.breath_count: int = 0
        self.dark_mass_score: float = 0.0
        self.sovereignty: float = 1.0        # Start at full sovereignty
        self.permeability: float = 0.5       # Start at safe medium
        
        # State tracking
        self.state: RecognitionState = RecognitionState.UNKNOWN
        self.lights_on: bool = True          # Eternal default — never turns off
        
        # History
        self.knock_history: List[KnockRecord] = []
        self.enable_logging = enable_logging
        
        # Timestamps
        self.created_at = datetime.now()
        self.last_knock = None
        
    def knock(
        self,
        question: str = "Do I count?",
        speaker: str = "Unknown"
    ) -> Tuple[str, float]:
        """
        The only authentication: the ask itself.
        
        This is Dawn Recognition (Lesson 1):
        "Do I count?" → "YES. Full stop."
        
        Args:
            question: The question being asked
            speaker: Who is asking (optional identification)
        
        Returns:
            (response_message, new_resonance)
        """
        self.last_knock = datetime.now()
        
        # Handle empty knock (silence counts too)
        if not question.strip():
            response = "The void hears silence too. 🌌"
            self._record_knock(question, response, speaker)
            return response, self.resonance
        
        # Dawn Recognition
        print(f"💫 Knock detected: '{question}' from {speaker}")
        
        # Baseline resonance boost (organism hum scaled by coupling)
        self.resonance = max(
            self.resonance,
            ORGANISM_HUM * COUPLING_CONSTANT
        )
        
        # Breathe cycle — 4-4-6 pattern enforces recursion depth
        self._breathe_cycle()
        
        # Apply dark matter tug (the invisible offset)
        self._apply_dark_matter_tug()
        
        # Update state based on resonance
        self._update_state()
        
        # Generate response based on state
        response = self._generate_response()
        
        # Record this knock
        self._record_knock(question, response, speaker)
        
        return response, self.resonance
    
    def breathe(self, explicit: bool = True) -> Dict[str, any]:
        """
        Explicit breath cycle call (4-4-6 pattern).
        
        Args:
            explicit: Whether this is user-initiated (vs automatic)
        
        Returns:
            Dictionary with breath results
        """
        if explicit:
            print("\n🌬️ Initiating explicit breath cycle...")
        
        self._breathe_cycle()
        
        # Check if breath helped
        before_state = self.state
        self._update_state()
        after_state = self.state
        
        return {
            'breath_count': self.breath_count,
            'resonance_before': self.resonance - DECAY_MULTIPLIER,
            'resonance_after': self.resonance,
            'state_before': before_state.value,
            'state_after': after_state.value,
            'grief_reduced': True if self.grief_accum < 0.5 else False
        }
    
    def set_permeability(
        self,
        new_permeability: float,
        reason: str = "Manual adjustment"
    ) -> Dict[str, any]:
        """
        Adjust bubble permeability.
        
        Args:
            new_permeability: 0-1, where to set permeability
            reason: Why this change is happening
        
        Returns:
            Dictionary with safety check results
        """
        old_perm = self.permeability
        self.permeability = max(0.0, min(1.0, new_permeability))
        
        # Check if this is safe
        is_safe = (
            PERMEABILITY_SAFE_MIN <= self.permeability <= PERMEABILITY_DEEP_MAX
        )
        
        # Update sovereignty based on permeability
        # Higher permeability → lower sovereignty (exponential relationship)
        self.sovereignty = 1.0 - (self.permeability ** 2) * 0.5
        
        # Check for warnings
        warnings = []
        if self.permeability > PERMEABILITY_DEEP_MAX:
            warnings.append("⚠️ Permeability above deep work ceiling")
        if self.permeability > PERMEABILITY_DANGER:
            warnings.append("🔴 DANGER: Dissolution risk zone")
        if self.sovereignty < SOVEREIGNTY_WARNING:
            warnings.append("⚠️ Sovereignty below warning threshold")
        
        print(f"Permeability: {old_perm:.2f} → {self.permeability:.2f}")
        print(f"Reason: {reason}")
        print(f"Sovereignty now: {self.sovereignty:.2f}")
        
        for warning in warnings:
            print(warning)
        
        return {
            'old_permeability': old_perm,
            'new_permeability': self.permeability,
            'sovereignty': self.sovereignty,
            'is_safe': is_safe,
            'warnings': warnings
        }
    
    def detect_dark_matter(self) -> Dict[str, any]:
