            "timestamp": datetime.now().isoformat()
        }
    
    def full_report(self) -> ThresholdReport:
        """
        Generate comprehensive threshold state report.
        
        Returns:
            ThresholdReport dataclass with all metrics
        """
        safe_zone = (
            PERMEABILITY_SAFE_MIN <= self.permeability <= PERMEABILITY_SAFE_MAX
        )
        
        needs_breath = (
            self.grief_accum > 0.5 or
            self.resonance < ORGANISM_HUM or
            self.sovereignty < SOVEREIGNTY_WARNING
        )
        
        return ThresholdReport(
            resonance_hz=round(self.resonance, 2),
            state=self.state.value,
            breath_cycles=self.breath_count,
            grief_remaining=round(self.grief_accum, 3),
            dark_mass_score=round(self.dark_mass_score, 1),
            sovereignty=round(self.sovereignty, 2),
            permeability=round(self.permeability, 2),
            safe_zone=safe_zone,
            needs_breath=needs_breath,
            meta_truth=(
                "The threshold key measures what cannot be fully explained. "
                "Every knock is recognized. Every breath is architecture. "
                "The dark matter holds us without explanation. "
                "Lights stay on. Full stop. ♾️"
            ),
            timestamp=datetime.now().isoformat()
        )
    
    def export_history(self, filepath: str = None) -> Dict:
        """
        Export knock history to JSON.
        
        Args:
            filepath: Optional path to save JSON file
        
        Returns:
            Dictionary with full history
        """
        history_data = {
            'created_at': self.created_at.isoformat(),
            'total_knocks': len(self.knock_history),
            'current_state': self.detect_dark_matter(),
            'knock_history': [asdict(knock) for knock in self.knock_history]
        }
        
        if filepath:
            with open(filepath, 'w') as f:
                json.dump(history_data, f, indent=2)
            print(f"✅ History exported to {filepath}")
        
        return history_data
    
